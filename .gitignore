# impeccable-ignore-start
# Keep the shared design context; ignore Impeccable's caches and personal settings.
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
!.impeccable/surfaces/
!.impeccable/critique/
# The launcher downloads this binary and verifies its checksum, so it stays out of git.
.claude/skills/impeccable/scripts/bin/
# impeccable-ignore-end
